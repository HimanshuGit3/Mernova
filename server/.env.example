# Copy to server/.env and adjust. Never commit .env.
NODE_ENV=development
PORT=5000
# Use 127.0.0.1, not localhost (Node may resolve localhost to IPv6 ::1).
MONGODB_URI=mongodb://127.0.0.1:27017/fixit
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/fixit_test
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
# Development password for every seed account
SEED_PASSWORD=FixIt@2026
# Presidency University, Bengaluru (Itgalpura, Rajanukunte). See docs/DECISIONS.md.
CAMPUS_CENTER_LAT=13.1718
CAMPUS_CENTER_LNG=77.5362
AI_TRIAGE_ENABLED=true
AI_MODEL_ID=Xenova/clip-vit-base-patch32
AI_TIMEOUT_MS=8000
DUPLICATE_RADIUS_M=50
DUPLICATE_SIMILARITY=0.85
AUTO_CLOSE_HOURS=72
# Optional: absolute path to a Firebase service-account JSON kept OUTSIDE the repo
FIREBASE_SERVICE_ACCOUNT=
