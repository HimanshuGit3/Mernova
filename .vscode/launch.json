{
  // D8: the API address is passed at build time. Change the LAN IP to your laptop's
  // IPv4 address (run `ipconfig`) and allow TCP 5000 through Windows Firewall (README).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FixIt (emulator)",
      "type": "dart",
      "request": "launch",
      "cwd": "mobile",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://10.0.2.2:5000"]
    },
    {
      "name": "FixIt (phone on same Wi-Fi)",
      "type": "dart",
      "request": "launch",
      "cwd": "mobile",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://192.168.1.10:5000"]
    }
  ]
}
